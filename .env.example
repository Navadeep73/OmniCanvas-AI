# Copy this file to .env and fill in your own keys. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=models/gemini-embedding-001

# Storage (defaults live in ./data)
# DATABASE_URL=sqlite:///./data/omnicanvas.db
# CHROMA_PATH=./data/chroma
# UPLOAD_DIR=./data/uploads

# Behaviour
MAX_UPLOAD_MB=25
USE_VISION=true            # caption figures / OCR scans with Gemini vision while indexing
VISION_PAGES_LIMIT=6       # max figure pages captioned per PDF
REWRITE_QUERIES=true       # make follow-up questions standalone before retrieval
RERANK_MODE=none           # none | llm
REDACT_INPUT_PII=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_MIN=10
